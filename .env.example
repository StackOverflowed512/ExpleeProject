# Copy this file to `.env` and adjust the values for your machine.
# `.env` is ignored by Git; never commit real credentials.

# Deployment environment: development | testing | production
APP_ENV=development

# PostgreSQL connection URL. The application only supports the psycopg 3
# driver, so the scheme must be `postgresql+psycopg`.
# If the password contains URL-reserved characters, percent-encode them
# (for example `@` -> `%40`).
DATABASE_URL=postgresql+psycopg://explee:change-me@localhost:5432/explee

# Root logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Explorer discovery --------------------------------------------------
# Search provider: `tavily` (default; Tavily Search API, requires
# TAVILY_API_KEY) or `fake` (no credentials, returns no results).
SEARCH_PROVIDER=tavily

# Tavily Search API key. Optional at startup so the app and unrelated tests
# run without it; discovery returns a clear provider_not_configured error
# when Tavily is selected without a key. Obtain a key at
# https://app.tavily.com/home and never commit a real key. Tavily's free
# tier is limited and subject to Tavily's current pricing and terms.
# TAVILY_API_KEY=tvly-your-key-here

# Timeout for a single provider request, in seconds (0 < value <= 60).
SEARCH_TIMEOUT_SECONDS=10

# Retries for transient failures (429 / 5xx / timeouts), 0-5.
SEARCH_MAX_RETRIES=2

# --- Explorer website research --------------------------------------------
# Research fetches the website stored on a discovered candidate directly with
# HTTPX. It never calls Tavily (no search credits) and needs no credentials.
# Fetcher: `httpx` (default; real HTTP with SSRF protections) or `fake`
# (no network access).
WEBSITE_FETCHER=httpx

# Per-request timeouts and the total wall-clock budget for one research
# fetch including redirects, in seconds.
RESEARCH_CONNECT_TIMEOUT_SECONDS=5
RESEARCH_READ_TIMEOUT_SECONDS=10
RESEARCH_MAX_FETCH_SECONDS=20

# Maximum body bytes read per page (10000-10000000); larger pages are
# truncated and recorded as `partial`.
RESEARCH_MAX_RESPONSE_BYTES=2000000

# Maximum redirects followed (0-10); every target is revalidated.
RESEARCH_MAX_REDIRECTS=5

# Maximum characters of extracted text stored per page (1000-200000).
RESEARCH_MAX_TEXT_CHARS=50000

# Usable research younger than this many hours is reused instead of fetching
# again (unless refresh is requested). 0 disables reuse.
RESEARCH_FRESHNESS_HOURS=24

# --- Outreach draft generation ----------------------------------------------
# Generator: `mistral` (default; Mistral chat completions, requires
# MISTRAL_API_KEY) or `fake` (deterministic drafts, no network, no key).
# Drafts are only generated and stored as `pending`; nothing is ever sent.
DRAFT_GENERATOR=mistral

# Mistral API key. Optional at startup so the app and tests run without it;
# draft generation returns provider_not_configured (HTTP 503) when Mistral
# is selected without a key. Create one at https://console.mistral.ai/ and
# never commit a real key.
# MISTRAL_API_KEY=your-mistral-api-key

# Model used for drafts, timeout per request (0 < value <= 120 seconds), and
# retries for transient failures such as 429/5xx/timeouts (0-3).
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=30
MISTRAL_MAX_RETRIES=1

# Dedicated database for PostgreSQL integration tests. Leave unset to skip
# those tests; never point this at the application database.
# TEST_DATABASE_URL=postgresql+psycopg://explee:change-me@localhost:5432/explee_test

# Email provider credentials are intentionally absent: Phase 4 only drafts
# messages. Approval and delivery settings arrive with Phase 5.
