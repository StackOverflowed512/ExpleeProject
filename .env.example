# Copy this file to `.env` and adjust the values for your machine.
# `.env` is ignored by Git; never commit real credentials.

# Deployment environment: development | testing | production
APP_ENV=development

# PostgreSQL connection URL. The application only supports the psycopg 3
# driver, so the scheme must be `postgresql+psycopg`.
# If the password contains URL-reserved characters, percent-encode them
# (for example `@` -> `%40`).
DATABASE_URL=postgresql+psycopg://explee:change-me@localhost:5432/explee

# Root logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Explorer discovery --------------------------------------------------
# Search provider: `fake` (no credentials, returns no results) or `brave`
# (Brave Search API, https://api-dashboard.search.brave.com/).
SEARCH_PROVIDER=fake

# Required only when SEARCH_PROVIDER=brave. Obtain a key from
# https://api-dashboard.search.brave.com/app/keys. Never commit a real key.
# SEARCH_API_KEY=

# Timeout for a single provider request, in seconds (0 < value <= 60).
SEARCH_TIMEOUT_SECONDS=10

# Retries for transient failures (429 / 5xx / timeouts), 0-5.
SEARCH_MAX_RETRIES=2

# --- Explorer website research -------------------------------------------
# Timeouts for a single company website fetch, in seconds.
WEBSITE_FETCH_CONNECT_TIMEOUT_SECONDS=5
WEBSITE_FETCH_READ_TIMEOUT_SECONDS=10
WEBSITE_FETCH_TOTAL_TIMEOUT_SECONDS=15

# Maximum response bytes downloaded and characters of visible text retained.
WEBSITE_FETCH_MAX_BYTES=2000000
WEBSITE_FETCH_MAX_TEXT_CHARS=20000

# Maximum redirects followed per fetch (0-10).
WEBSITE_FETCH_MAX_REDIRECTS=3

# Dedicated database for PostgreSQL integration tests. Leave unset to skip
# those tests; never point this at the application database.
# TEST_DATABASE_URL=postgresql+psycopg://explee:change-me@localhost:5432/explee_test

# AI and email provider credentials (for example Mistral) are intentionally
# absent through Phase 2. Website research needs no credentials and is
# configured entirely by the WEBSITE_FETCH_* settings above.
